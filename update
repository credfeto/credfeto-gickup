#! /bin/sh

[ -d "/data/gickup" ] || sudo mkdir -p "/data/gickup"

# sh has already parsed this script, so changes the pull brings to it would
# only take effect on the next run. Re-run the freshly pulled copy once.
if [ "${UPDATE_ALREADY_PULLED:-}" != "1" ]; then
    git pull
    UPDATE_ALREADY_PULLED=1 exec "$(readlink -f "$0")" "$@"
fi


sudo docker volume create \
  --opt type=none \
  --opt o=bind \
  --opt device=/data/gickup \
  gickup_data


sudo docker compose pull && sudo docker compose up -d

# Egress lockdown (firewalld policies); observation mode unless
# GICKUP_FIREWALL_ENFORCE=true in .env. Runs after the containers exist,
# because Docker creates the docker zone the policies refer to. See README.md,
# "Host firewall".
sudo "$(dirname "$(readlink -f "$0")")/firewall/configure" || exit 1
