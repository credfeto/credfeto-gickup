#!/usr/bin/env python3
"""Builds and loads the gickup host's egress firewall as one nftables table.

The table is `inet gku_egress`, with one base chain:
  host_out    hook output:  what the host itself may connect to, including
                            the gickup-backup service mirroring from GitHub
                            and gitlab.com.

It is a table of its own, not firewalld policies: the whole ruleset, including
the address sets, is replaced in a single `nft -f` transaction. So a refresh
never makes firewalld reload, and a failed load leaves the previous rules in
place. firewalld keeps the base zones (SSH and so on) and never sees this
table.

Runs as root from gickup-egress-refresh.timer (every 10 minutes), from
firewall/configure (which ../update runs) and from firewall/sync. Each run:
  * resolves the CDN-fronted names (falling back to the last good answer for
    a name that does not resolve right now),
  * reads the published GitHub and Cloudflare ranges,
  * renders the table and loads it only if it differs from what is loaded.

Enforcement comes from ENFORCE_FILE, which firewall/configure writes from
GICKUP_FIREWALL_ENFORCE in ../.env: "true" drops unmatched new connections;
anything else only logs them ("gku-egress-unmatched: ", 30 a minute) and lets
them through.
"""

import ipaddress
import json
import os
import socket
import subprocess
import sys
import tempfile

TABLE = "gku_egress"
PREFIX = "gku-egress"
STATE_DIR = "/var/lib/credfeto-gickup"
ENFORCE_FILE = os.path.join(STATE_DIR, "egress-enforce")
CACHE_FILE = os.path.join(STATE_DIR, "egress-resolved.json")
LOADED_FILE = os.path.join(STATE_DIR, "egress.nft")
RANGES_DIR = "/usr/local/share/credfeto-gickup"
ENCODING = "utf-8"

# The reverse proxies (Traefik): the pacman cache and metrics shipping.
PROXIES = [
    "192.168.140.250",
    "192.168.140.251",
    "2a02:8010:61d5:140::250",
    "2a02:8010:61d5:140::251",
]
# The fleet's DNS servers.
DNS = [f"192.168.42.10{n}" for n in range(1, 7)] + [
    f"2a02:8010:61d5:42::10{n}" for n in range(1, 7)
]
# Central logging (journald uploads to VictoriaLogs on monitoring.lan).
LOGS = ["192.168.160.134"]
# GitHub Pages / raw content / release assets (Fastly).
FASTLY = ["185.199.108.0/22", "2606:50c0::/32"]

# Names without a stable address, resolved on every run. slug -> name.
DOMAINS = {
    "github": "github.com",
    "chaotic": "cdn-mirror.chaotic.cx",
    "pkgstats": "pkgstats.archlinux.de",
    "archwkd": "openpgpkey.archlinux.org",
    "gitlab": "gitlab.com",
}
# Published ranges, shipped in the repo and regenerated daily by the
# "Repo: Update egress ranges" workflow. slug -> file in RANGES_DIR.
RANGES = {
    "ghnet": "github-egress-ranges",
    "cfnet": "cloudflare-egress-ranges",
}

# gickup-backup lists repositories through the GitHub and GitLab APIs and
# fetches them over HTTPS (gitlab.com is behind Cloudflare); the host itself
# pulls this checkout from GitHub and packages from chaotic-aur.
HTTPS_SETS = [
    "github",
    "ghnet",
    "cfnet",
    "gitlab",
    "chaotic",
    "pkgstats",
    "archwkd",
]
# gickup-backup fetches the token owner's own and starred GitHub
# repositories over SSH.
SSH_SETS = ["github", "ghnet"]

NAT64 = ipaddress.ip_network("64:ff9b::/96")


def log(msg):
    """Writes a progress or warning line to stderr, for the journal."""
    print(f"egress: {msg}", file=sys.stderr)


def nat64(v4net):
    """The NAT64 (RFC 6052 well-known prefix) form of an IPv4 network: this
    network runs DNS64, so IPv6-preferring clients reach IPv4-only hosts that
    way."""
    base = int(NAT64.network_address) + int(v4net.network_address)
    return ipaddress.ip_network((base, 96 + v4net.prefixlen))


def split(nets):
    """IPv4 and IPv6 networks, the IPv6 side including the NAT64 form of every
    IPv4 network, each collapsed so overlapping entries cannot make nft reject
    the set."""
    v4 = [n for n in nets if n.version == 4]
    v6 = [
        n
        for n in nets
        if n.version == 6 and n not in NAT64 and not n.subnet_of(NAT64)
    ]
    v6 += [nat64(n) for n in v4]
    return (
        list(ipaddress.collapse_addresses(v4)),
        list(ipaddress.collapse_addresses(v6)),
    )


def resolve(name):
    """The sorted, de-duplicated addresses a name resolves to."""
    infos = socket.getaddrinfo(name, 443, proto=socket.IPPROTO_TCP)
    return sorted({info[4][0] for info in infos})


def load_cache():
    """The last good resolved addresses, slug -> addresses; empty if none."""
    try:
        with open(CACHE_FILE, encoding=ENCODING) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_cache(resolved):
    """Atomically replaces the cache of resolved addresses."""
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = CACHE_FILE + ".tmp"
    with open(tmp, "w", encoding=ENCODING) as f:
        json.dump(resolved, f, indent=1, sort_keys=True)
    os.replace(tmp, CACHE_FILE)


def read_ranges(path):
    """The networks in a published ranges file, ignoring # comments."""
    nets = []
    with open(path, encoding=ENCODING) as f:
        for line in f:
            line = line.split("#", 1)[0].strip()
            if line:
                nets.append(ipaddress.ip_network(line, strict=False))
    return nets


def resolve_or_cached(slug, name, cache):
    """A name's addresses, or its cached ones when it does not resolve."""
    try:
        return resolve(name)
    except OSError as e:
        addrs = cache.get(slug, [])
        log(
            f"{name} did not resolve ({e}); "
            f"keeping the {len(addrs)} cached address(es)"
        )
        return addrs


def gather_sets():
    """slug -> (v4 networks, v6 networks)."""
    cache = load_cache()
    resolved = {}
    sets = {}
    for slug, name in DOMAINS.items():
        addrs = resolve_or_cached(slug, name, cache)
        resolved[slug] = addrs
        # Resolver-supplied 64:ff9b:: answers are dropped by split() and
        # recomputed from the IPv4 answers, so DNS64 state cannot make the
        # sets flap between runs.
        sets[slug] = split([ipaddress.ip_network(a) for a in addrs])
    for slug, filename in RANGES.items():
        path = os.path.join(RANGES_DIR, filename)
        try:
            sets[slug] = split(read_ranges(path))
        except OSError as e:
            log(f"{path} unreadable ({e}); {slug} is empty")
            sets[slug] = ([], [])
    save_cache(resolved)
    return sets


def run(args):
    """Runs a command, capturing its output; the caller checks the status."""
    return subprocess.run(args, capture_output=True, text=True, check=False)


def default_gateways():
    """The IPv4 and IPv6 default gateways, link-local ones excluded."""
    gws = []
    for fam in ("-4", "-6"):
        out = run(["ip", fam, "route", "show", "default"]).stdout
        for line in out.splitlines():
            words = line.split()
            if (
                len(words) > 2
                and words[:2] == ["default", "via"]
                and not words[2].startswith("fe80:")
            ):
                gws.append(words[2])
    if not gws:
        log("no default gateway; NTP to the router is not allowed")
    return gws


def addr_rules(addrs, match):
    """One rule per family for a static list of addresses or networks."""
    nets = [ipaddress.ip_network(a, strict=False) for a in addrs]
    rules = []
    for fam, kw in ((4, "ip"), (6, "ip6")):
        fam_nets = [str(n) for n in nets if n.version == fam]
        if fam_nets:
            joined = ", ".join(fam_nets)
            rules.append(f"{kw} daddr {{ {joined} }} {match} accept")
    return rules


def set_rules(slugs, sets, match):
    """One rule per family for each named set that has any members."""
    rules = []
    for slug in slugs:
        v4, v6 = sets[slug]
        if v4:
            rules.append(f"ip daddr @{slug}_v4 {match} accept")
        if v6:
            rules.append(f"ip6 daddr @{slug}_v6 {match} accept")
    return rules


def chain(name, hook, rules, enforce):
    """An nft base chain: replies first, then the rules, then the
    rate-limited log (and the drop, when enforcing) for anything else."""
    lines = [
        f"\tchain {name} {{",
        f"\t\ttype filter hook {hook} priority filter - 10; policy accept;",
        # Replies to accepted connections, including inbound SSH and anything
        # the host's zones let in.
        "\t\tct state established,related accept",
    ]
    if enforce:
        lines.append("\t\tct state invalid drop")
    lines += [f"\t\t{r}" for r in rules]
    lines.append(
        f'\t\tlimit rate 30/minute log prefix "{PREFIX}-unmatched: " '
        "level info"
    )
    if enforce:
        lines.append("\t\tdrop")
    lines.append("\t}")
    return lines


def render_sets(sets):
    """The nft set declarations for every non-empty address family."""
    out = []
    for slug, (v4, v6) in sorted(sets.items()):
        for suffix, kind, nets in (
            ("v4", "ipv4_addr", v4),
            ("v6", "ipv6_addr", v6),
        ):
            if not nets:
                continue
            elements = ", ".join(str(n) for n in nets)
            out.append(f"\tset {slug}_{suffix} {{")
            out.append(f"\t\ttype {kind}; flags interval;")
            out.append(f"\t\telements = {{ {elements} }}")
            out.append("\t}")
    return out


def host_rules(sets, gateways):
    """What the host may connect to, apart from loopback."""
    dns = "meta l4proto { tcp, udp } th dport 53"
    rules = [
        'oifname "lo" accept',
        # ICMPv6 is fundamental (NDP, PMTU discovery); IGMP, DHCP and DHCPv6
        # are link-local housekeeping.
        "meta l4proto ipv6-icmp accept",
        "meta l4proto { icmp, igmp } accept",
        "udp dport { 67, 547 } accept",
    ]
    # NTP: the router's address on this host's VLAN (the default gateway).
    rules += addr_rules(gateways, "udp dport 123")
    rules += addr_rules(DNS, dns)
    # The proxies (the pacman cache, metrics shipping) and GitHub's Fastly
    # ranges.
    rules += addr_rules(PROXIES + FASTLY, "tcp dport 443")
    rules += addr_rules(LOGS, "tcp dport 9428")
    rules += set_rules(SSH_SETS, sets, "tcp dport 22")
    rules += set_rules(HTTPS_SETS, sets, "tcp dport 443")
    return rules


def render(sets, gateways, enforce):
    """The whole nft script: replaces the table in one transaction."""
    out = [
        f"table inet {TABLE}",
        f"delete table inet {TABLE}",
        f"table inet {TABLE} {{",
    ]
    out += render_sets(sets)
    out += chain("host_out", "output", host_rules(sets, gateways), enforce)
    out.append("}")
    return "\n".join(out) + "\n"


def loaded():
    """The ruleset last loaded, or None when the table is not loaded."""
    try:
        with open(LOADED_FILE, encoding=ENCODING) as f:
            text = f.read()
    except OSError:
        return None
    # The table can be gone even though the file is current (after a reboot,
    # or someone flushing the ruleset).
    if run(["nft", "list", "table", "inet", TABLE]).returncode != 0:
        return None
    return text


def read_enforce():
    """Whether unmatched connections are dropped rather than only logged."""
    try:
        with open(ENFORCE_FILE, encoding=ENCODING) as f:
            return f.read().strip() == "true"
    except OSError:
        return False


def load(text):
    """Checks then loads a ruleset, leaving the old one in place on error."""
    fd, path = tempfile.mkstemp(dir=STATE_DIR, suffix=".nft")
    with os.fdopen(fd, "w", encoding=ENCODING) as f:
        f.write(text)
    # Check first, so a bad ruleset never touches the loaded one; the load
    # itself is one transaction as well.
    check = run(["nft", "-c", "-f", path])
    if check.returncode != 0:
        os.unlink(path)
        sys.exit(
            "egress: ruleset rejected, previous one left in place:\n"
            f"{check.stderr}"
        )
    result = run(["nft", "-f", path])
    if result.returncode != 0:
        os.unlink(path)
        sys.exit(
            "egress: load failed, previous ruleset left in place:\n"
            f"{result.stderr}"
        )
    os.replace(path, LOADED_FILE)


def main():
    """Renders the table and loads it when it differs from the loaded one."""
    if os.geteuid() != 0:
        sys.exit("egress: must run as root")
    enforce = read_enforce()
    text = render(gather_sets(), default_gateways(), enforce)
    if text == loaded():
        return
    load(text)
    mode = "enforcing" if enforce else "observation mode"
    log(f"loaded table inet {TABLE} ({mode})")


if __name__ == "__main__":
    main()
