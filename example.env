# Copy to .env to override defaults. Watchtower uses a 6-field cron (seconds first); default runs hourly at minute 24.
WATCHTOWER_SCHEDULE="0 24 * * * *"

# Host firewall (firewall/configure, run by ./update): "true" drops traffic the
# rules do not allow; anything else only logs it (observation mode).
# GICKUP_FIREWALL_ENFORCE=true
